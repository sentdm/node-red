# Public source allowlist. New public files require an intentional entry here.
/*
!/.gitignore
!/package.json
!/package-lock.json
!/eslint.config.js
!/README.md
!/LICENSE
!/SECURITY.md
!/ARCHITECTURE.md
!/CONTRIBUTING.md
!/nodes/
/nodes/*
!/nodes/sent.js
!/nodes/sent.html
!/nodes/lib/
/nodes/lib/*
!/nodes/lib/client.js
!/nodes/lib/actions.js
!/nodes/lib/webhooks.js
!/nodes/lib/raw-body.js
!/nodes/icons/
/nodes/icons/*
!/nodes/icons/sent.svg
!/examples/
/examples/*
!/examples/sent-demo.json
!/examples/sent-live-sandbox.json
!/dev/
/dev/*
!/dev/audit-openapi.js
!/dev/build-editor.js
!/dev/build-flows.js
!/dev/check-generated.js
!/dev/demo.js
!/dev/editor-runtime.js
!/dev/fresh.js
!/dev/mock.js
!/test/
/test/*
!/test/*.test.js

# Never include local credentials, runtime state, evidence or dependencies.
node_modules/
.npmrc
npmrc
.env*
*.pem
*.key
*.p12
*.pfx
*_cred.json
*.log
*.tgz
.DS_Store
.demo*/
.fresh*/
.tooling/
.npm-cache/
.release-local/
.test-runtime/
/qa/
/QA_REPORT.md
